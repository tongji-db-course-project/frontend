# ===== 前端环境变量·基础配置（所有模式共享，可提交仓库） =====
# 说明：
# - 本文件被所有模式加载；`.env.development` 会在此基础上覆盖开发专用值。
# - 变量必须以 VITE_ 开头才会注入前端代码（import.meta.env.*）。
# - 敏感/私有值请放到被 git 忽略的 .env.local，不要写在这里。

# --- 接口地址 ---
# 后端 API 基地址（直连后端，不经 Vite 代理）。
# 注意：后端路由无 /api 前缀，登录接口为 /auth/login，故此处不带 /api。
VITE_API_BASE_URL=http://localhost:5113

# 登录接口路径（拼接在 VITE_API_BASE_URL 之后 → http://localhost:5113/auth/login）
VITE_AUTH_LOGIN_PATH=/auth/login

# --- Mock 开关（默认全部关闭，走真实后端） ---
# 登录及通用本地 Mock：离线联调时置为 true
VITE_USE_LOCAL_MOCK=false
# 角色管理模块本地 Mock（仅开发模式 import.meta.env.DEV 下生效）
VITE_USE_ROLE_LOCAL_MOCK=false
